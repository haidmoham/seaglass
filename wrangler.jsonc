{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seaglass-exhibit",
  "main": "src/server/worker.ts",
  "account_id": "7ccfdec2aec5b063d5c1a1a476e4ca83",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    { "pattern": "seaglass.shin86.dev", "custom_domain": true },
    { "pattern": "seaglass.mhaider.dev", "custom_domain": true },
  ],
}
